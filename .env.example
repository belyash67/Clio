# Copy to .env.local; never commit real credentials.
# Keep false until applicable KG requirements, hosting terms and documents are reviewed.
# This operational flag does not certify legal compliance. Development remains local.
CLIO_PUBLIC_ACCOUNTS_ENABLED=false
# Required for production access: UTC ISO timestamps, maximum 31 days apart.
# No dates selected yet. Expiration closes access; it does not delete data.
CLIO_ACCESS_STARTS_AT=
CLIO_ACCESS_ENDS_AT=
DATABASE_URL=postgresql://clio:CHANGE_ME@localhost:5432/clio
BETTER_AUTH_URL=http://localhost:3000
# In production use the public HTTPS origin and a PostgreSQL URL with sslmode=verify-full.
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
# Real SMTP credentials are required for registration and password recovery.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Server-only TMDB API Read Access Token. Never prefix with NEXT_PUBLIC_.
TMDB_READ_ACCESS_TOKEN=
# system (default) or https (Google Public DNS, TMDB API and image hostnames only).
TMDB_DNS_MODE=system
