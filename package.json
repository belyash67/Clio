{
  "name": "clio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "package:hosted": "node scripts/package-hosted.mjs",
    "launch:check": "node scripts/check-production-config.mjs",
    "secrets:check": "node scripts/check-secrets.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:setup": "tsx scripts/setup-local-db.ts",
    "mail:check": "node scripts/check-mail.mjs",
    "tmdb:check": "node scripts/check-tmdb.mjs",
    "admin:grant": "node scripts/grant-owner-admin.mjs",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "tsx --env-file=.env.local scripts/check-db.ts",
    "test:e2e": "node scripts/run-e2e.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "18.0.10",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "better-auth": "1.7.23",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.72.0",
    "next": "16.4.6",
    "next-themes": "0.4.6",
    "nodemailer": "10.5.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  }
}
